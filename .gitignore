# Local database — user data, never committed.
# (data/companies.toml is source data and IS tracked; see the negations below.)
data/*.db
data/*.db-wal
data/*.db-shm
*.db
*.db-wal
*.db-shm

# Personal facts (name/email/phone/resume-derived) — never committed.
data/personal.toml

# runtime reports (daily output, last-run state)
reports/

# local agent/tooling state (never committed)
.commandcode/

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# editor / OS
.DS_Store
.idea/
.vscode/

# secrets — never commit
.env
.env.*
*.key
*.pem
*.p12
secrets*
*credentials*.json
*token*.json
gcp-*.json
client_secret*.json
service-account*.json

# Gmail OAuth credentials + tokens — never commit
*gmail-credentials*.json
*gmail-token*.json

# local captures (may contain PII/private data) — never commit
*.png
*.jpg
*.jpeg
*.webp
*screenshot*
